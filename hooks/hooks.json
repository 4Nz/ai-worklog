{
  "description": "Expose the current Claude Code session identity to ai-worklog",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/claude_session_start.py\"",
            "async": false,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
